(define (domain scenario_solver_example1-domain)
 (:requirements :strips :typing :equality :numeric-fluents)
 (:types arrivaltrain trainunit departurerequest requestslot unittype)
 (:predicates 
             (available ?unit - trainunit)
             (request_open ?request - departurerequest)
             (slot_open ?slot - requestslot)
             (slot_filled ?slot - requestslot)
             (compatible ?unit - trainunit ?slot - requestslot)
             (matched ?unit - trainunit ?slot - requestslot)
             (slot_for_request ?slot - requestslot ?request - departurerequest)
             (has_type ?unit - trainunit ?utype - unittype)
             (requires_type ?slot - requestslot ?utype - unittype)
             (member_of_arrival ?unit - trainunit ?train - arrivaltrain)
             (same_arrival ?unit_a - trainunit ?unit_b - trainunit)
             (arrival_ready ?unit - trainunit ?request - departurerequest)
             (request_fulfilled ?request - departurerequest)
             (no_split_needed ?request - departurerequest)
             (first_slot ?slot - requestslot)
             (prev_slot ?slot - requestslot ?prev - requestslot)
 )
 (:functions 
             (arrival ?train - arrivaltrain)
             (departure ?request - departurerequest)
             (slots_filled_count ?request - departurerequest)
             (slots_total ?request - departurerequest)
 )
 (:action match_first
  :parameters ( ?unit - trainunit ?slot - requestslot ?request - departurerequest)
  :precondition (and (available ?unit) (slot_open ?slot) (compatible ?unit ?slot) (slot_for_request ?slot ?request) (request_open ?request) (arrival_ready ?unit ?request) (first_slot ?slot))
  :effect (and (matched ?unit ?slot) (slot_filled ?slot) (not (available ?unit)) (not (slot_open ?slot)) (increase (slots_filled_count ?request) 1)))
 (:action match_next
  :parameters ( ?unit - trainunit ?slot - requestslot ?request - departurerequest ?predecessor - requestslot)
  :precondition (and (available ?unit) (slot_open ?slot) (compatible ?unit ?slot) (slot_for_request ?slot ?request) (request_open ?request) (arrival_ready ?unit ?request) (prev_slot ?slot ?predecessor) (slot_filled ?predecessor))
  :effect (and (matched ?unit ?slot) (slot_filled ?slot) (not (available ?unit)) (not (slot_open ?slot)) (increase (slots_filled_count ?request) 1)))
 (:action close_request
  :parameters ( ?request - departurerequest)
  :precondition (and (request_open ?request) (= (slots_filled_count ?request) (slots_total ?request)))
  :effect (and (not (request_open ?request)) (request_fulfilled ?request)))
)
